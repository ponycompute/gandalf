{
  "name": "gandalf",
  "private": true,
  "version": "0.7.0",
  "description": "Skill manager and local work handoff for coding agents",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:cli": "cargo build --release --locked -p gandalf-cli",
    "test": "turbo run test",
    "test:cli": "cargo test --workspace --all-features",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "dev": "turbo run dev",
    "clean": "turbo run clean && rm -rf node_modules apps/*/node_modules apps/*/dist apps/*/.turbo .turbo"
  },
  "devDependencies": {
    "turbo": "^2.4.4"
  },
  "packageManager": "bun@1.2.0"
}
