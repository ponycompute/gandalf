---
import { FolderInput, Search, ShieldCheck } from 'lucide-react';

const steps = [
  {
    label: "Collect",
    cmd: "gandalf export",
    desc: "Pull the skills already scattered across your agents into .gandalf/skills/ and a gandalf.toml — or start fresh with gandalf init.",
    note: "skills as code",
  },
  {
    label: "Gate",
    cmd: "gandalf check --ci",
    desc: "Fail the PR when any agent is missing a team skill or running a stale copy. Read-only, locally and in CI.",
    note: "zero-mutation discovery",
  },
  {
    label: "Ship",
    cmd: "gandalf apply --yes",
    desc: "Install every team skill into Claude Code, Codex, and Cursor. Personal skills stay untouched; a snapshot is taken first.",
    note: "1-command rollback",
  },
];

const scope = [
  ["Skill Format", "One directory per skill with a SKILL.md entrypoint, installed as-is"],
  ["Skill Targets", "~/.claude/skills · ~/.codex/skills · ~/.cursor/skills"],
  ["Path Confinement", "Skill sources must live inside the repo; no ../ traversal"],
  ["Inspect", "gandalf tui opens a Skills tab that renders each SKILL.md"],
  ["Rollback Guard", "Automatic pre-apply snapshots restorable via gandalf restore"],
  ["Beyond Skills", "MCP servers, hooks, and required env ride the same manifest"],
];
---

<section class="section primitives" id="primitives">
  <div class="container">
    <div class="primitives__head" data-reveal>
      <div>
        <p class="section-meta">
          <span class="section-meta__num">02</span> &nbsp;/&nbsp; The Workflow
        </p>
        <h2 class="section-title">Ship a skill in three steps.</h2>
      </div>
      <p class="section-lede">
        Skills live in Git next to your code. Gandalf collects them, gates them in CI, and installs them into every agent.
      </p>
    </div>

    <div class="workflow" aria-label="Gandalf setup workflow">
      <span class="workflow__progress" data-line-grow aria-hidden="true"></span>
      {steps.map((step, index) => (
        <article class="workflow__step" data-reveal data-spotlight style={`--i:${index}`}>
          <span class="workflow__index">{String(index + 1).padStart(2, "0")}</span>
          {index === 0 && <FolderInput className="workflow__icon" size={22} strokeWidth={2} aria-hidden="true" />}
          {index === 1 && <Search className="workflow__icon" size={22} strokeWidth={2} aria-hidden="true" />}
          {index === 2 && <ShieldCheck className="workflow__icon" size={22} strokeWidth={2} aria-hidden="true" />}
          <h3>{step.label}</h3>
          <code><span>$</span> {step.cmd}</code>
          <p>{step.desc}</p>
          <strong>{step.note}</strong>
        </article>
      ))}
    </div>

    <div class="scope-panel" data-reveal aria-label="Gandalf supported scope">
      <div class="scope-panel__copy">
        <span>Skill Guarantees</span>
        <strong>Non-destructive by design.</strong>
      </div>
      <div class="scope-panel__rows">
        {scope.map(([name, value]) => (
          <div>
            <code>{name}</code>
            <span>{value}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .primitives {
    background: rgb(255 255 255 / 0.82);
  }

  .primitives__head {
    display: grid;
    grid-template-columns: minmax(280px, 0.9fr) minmax(280px, 0.8fr);
    gap: 40px;
    align-items: end;
    margin-bottom: 28px;
  }

  .primitives__head .section-title {
    font-size: clamp(2.0rem, 2.8vw, 2.8rem);
    line-height: 1.15;
  }

  .primitives__head .section-lede {
    font-size: 0.96rem;
    line-height: 1.6;
    color: var(--muted-foreground);
    margin-bottom: 0;
  }

  .workflow {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: rgb(255 255 255 / 0.92);
    box-shadow: 0 10px 30px -20px rgb(15 23 42 / 0.25);
  }

  .workflow__progress {
    position: absolute;
    inset: 0 0 auto;
    z-index: 1;
    height: 2px;
    background: var(--foreground);
  }

  .workflow__step {
    padding: 28px 24px;
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .workflow__step:last-child {
    border-right: none;
  }

  .workflow__index {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--muted-foreground);
    margin-bottom: 12px;
  }

  :global(.workflow__icon) {
    color: var(--brand);
    margin-bottom: 14px;
  }

  .workflow__step h3 {
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: 10px;
    color: var(--foreground);
  }

  .workflow__step code {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 4px 8px;
    background: #f4f4f5;
    border-radius: var(--radius-sm);
    color: var(--foreground);
    margin-bottom: 12px;
    width: fit-content;
  }

  .workflow__step code span {
    color: var(--brand);
    margin-right: 4px;
  }

  .workflow__step p {
    font-size: 0.88rem;
    color: var(--muted-foreground);
    line-height: 1.55;
    margin-bottom: 16px;
    flex-grow: 1;
  }

  .workflow__step strong {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--foreground);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .scope-panel {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-top: 24px;
    overflow: hidden;
    background: #fafafa;
  }

  .scope-panel__copy {
    padding: 20px 24px;
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #ffffff;
  }

  .scope-panel__copy span {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    color: var(--muted-foreground);
    letter-spacing: 0.04em;
    margin-bottom: 4px;
  }

  .scope-panel__copy strong {
    font-size: 0.95rem;
    color: var(--foreground);
  }

  .scope-panel__rows {
    padding: 8px 16px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .scope-panel__rows div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 8px;
    border-bottom: 1px solid rgb(0 0 0 / 0.04);
    font-size: 0.84rem;
  }

  .scope-panel__rows div:last-child {
    border-bottom: none;
  }

  .scope-panel__rows code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--foreground);
  }

  .scope-panel__rows span {
    color: var(--muted-foreground);
    text-align: right;
  }

  @media (max-width: 900px) {
    .primitives__head {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .workflow {
      grid-template-columns: 1fr;
    }

    .workflow__step {
      border-right: none;
      border-bottom: 1px solid var(--border);
    }

    .workflow__step:last-child {
      border-bottom: none;
    }

    .scope-panel {
      grid-template-columns: 1fr;
    }

    .scope-panel__copy {
      border-right: none;
      border-bottom: 1px solid var(--border);
    }

    .scope-panel__rows div {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }

    .scope-panel__rows span {
      text-align: left;
    }
  }
</style>
