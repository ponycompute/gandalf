---
import { Users } from 'lucide-react';

// Tally form "Gandalf Team Plan — Early Access" (https://tally.so/r/VLRvJl).
const tallyFormId = "VLRvJl";
const tallySrc = `https://tally.so/embed/${tallyFormId}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1&plan=team`;
---

<section class="section waitlist" id="team-plan">
  <!-- Keeps older /#team links (README, shared URLs) landing here. -->
  <span id="team" aria-hidden="true"></span>
  <div class="container waitlist__grid">
    <div>
      <p class="section-meta">
        <span class="section-meta__num">05</span> &nbsp;/&nbsp; Team Plan · Early Access
      </p>
      <h2 class="section-title">Get early access to the Team plan.</h2>
      <p class="section-lede">
        We're building a paid plan for engineering teams that run more than one coding agent. Tell us how your team works and we'll reach out when the first spots open.
      </p>
      <p class="waitlist__note">
        <Users size={14} strokeWidth={2} aria-hidden="true" />
        $49/month for 10 seats. The CLI stays free either way.
      </p>
    </div>

    <div class="waitlist__form">
      <iframe
        data-tally-src={tallySrc}
        loading="lazy"
        width="100%"
        height="360"
        frameborder="0"
        marginheight="0"
        marginwidth="0"
        title="Gandalf Team plan early access"
      ></iframe>
      <noscript>
        <a href={`https://tally.so/r/${tallyFormId}?plan=team`} class="btn btn--primary">Get early access</a>
      </noscript>
    </div>
  </div>
</section>

<script is:inline>
  // Tally's recommended loader: use embed.js for dynamic height, fall back to a plain iframe src if it fails.
  (function () {
    var d = document;
    var w = "https://tally.so/widgets/embed.js";
    var load = function () {
      if (typeof Tally !== "undefined") {
        Tally.loadEmbeds();
      } else {
        d.querySelectorAll("iframe[data-tally-src]:not([src])").forEach(function (e) {
          e.src = e.dataset.tallySrc;
        });
      }
    };
    if (typeof Tally !== "undefined") {
      load();
    } else if (d.querySelector('script[src="' + w + '"]') == null) {
      var s = d.createElement("script");
      s.src = w;
      s.onload = load;
      s.onerror = load;
      d.body.appendChild(s);
    }
  })();
</script>

<style>
  .waitlist {
    background: rgb(255 255 255 / 0.84);
  }

  .waitlist__grid {
    display: grid;
    grid-template-columns: minmax(280px, 0.9fr) minmax(0, 1fr);
    gap: 54px;
    align-items: start;
  }

  .waitlist .section-title {
    font-size: clamp(2.0rem, 2.8vw, 2.8rem);
    line-height: 1.15;
  }

  .waitlist .section-lede {
    font-size: 0.96rem;
    line-height: 1.6;
    margin-bottom: 18px;
  }

  .waitlist__note {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.84rem;
    color: var(--muted-foreground);
  }

  .waitlist__form {
    min-width: 0;
    padding: 20px 24px 8px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.92);
    box-shadow: 0 10px 30px -20px rgb(15 23 42 / 0.25);
  }

  .waitlist__form iframe {
    display: block;
    width: 100%;
    border: 0;
  }

  @media (max-width: 900px) {
    .waitlist__grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
