---
import XTermTerminal from './ui/XTermTerminal';

const installCommand = 'brew install qyinm/tap/gandalf';
---

<section class="hero">
  <div class="container">
    <p class="eyebrow">
      <a href="https://github.com/qyinm/gandalf/releases" class="hero__release">v0.9.0 · Open source, Apache-2.0</a>
    </p>
    <h1 class="hero__title">Shared skills for every coding agent on your team.</h1>
    <p class="hero__sub">
      Gandalf keeps one set of skills in your repo and installs it into Claude Code, Codex, and Cursor.
      With agbox, it also notices the work you keep repeating and drafts the skill for you.
    </p>

    <div class="hero__actions">
      <div class="hero__cmd">
        <code><span aria-hidden="true">$</span> {installCommand}</code>
        <button type="button" class="hero__copy" data-copy={installCommand} aria-label="Copy install command">Copy</button>
      </div>
      <a href="https://docs.usegandalf.com" class="hero__docs text-link">Read the docs</a>
    </div>
  </div>

  <div class="container hero__product">
    <XTermTerminal client:only="react" />
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
      } catch {
        return;
      }
      button.textContent = 'Copied';
      window.setTimeout(() => (button.textContent = 'Copy'), 1500);
    });
  });
</script>

<style>
  .hero {
    padding: 88px 0 112px;
  }

  .hero__release:hover {
    color: var(--foreground);
  }

  .hero__title {
    max-width: 15ch;
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .hero__sub {
    max-width: 52ch;
    margin-top: 24px;
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--muted-foreground);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: 36px;
  }

  .hero__cmd {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 6px 0 16px;
    border-radius: var(--radius-md);
    background: var(--foreground);
    color: var(--bg);
  }

  .hero__cmd code {
    font-size: 0.875rem;
    white-space: nowrap;
  }

  .hero__cmd code span {
    margin-right: 6px;
    color: var(--brand);
  }

  .hero__copy {
    height: 32px;
    min-width: 64px;
    margin-left: 14px;
    padding: 0 10px;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: var(--radius-sm);
    background: transparent;
    color: rgb(255 255 255 / 0.75);
    font-size: 0.75rem;
  }

  .hero__copy:hover {
    border-color: rgb(255 255 255 / 0.4);
    color: #fff;
  }

  .hero__docs {
    font-size: 0.9375rem;
  }

  .hero__product {
    margin-top: 72px;
  }

  @media (max-width: 720px) {
    .hero {
      padding: 48px 0 72px;
    }

    .hero__sub {
      font-size: 1rem;
    }

    .hero__cmd {
      width: 100%;
      justify-content: space-between;
    }

    .hero__cmd code {
      font-size: 0.78rem;
    }

    .hero__product {
      width: 100%;
      margin-top: 48px;
    }
  }
</style>
