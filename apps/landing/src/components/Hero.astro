---
import { Copy, Download } from 'lucide-react';
import Nav from './Nav.astro';
import XTermTerminal from './ui/XTermTerminal';
import ShaderBackdrop from './ShaderBackdrop.astro';

// Split at build time so each word can blur-rise in without layout shift.
const lead = "Your team's skills, in every agent,".split(' ');
const accent = 'from one repo.'.split(' ');
const installCommand = 'brew install qyinm/tap/gandalf';
---

<section class="hero">
  <div class="hero__scene">
    <ShaderBackdrop />
    <Nav />

    <div class="hero__copy">
      <h1 aria-label="Your team's skills, in every agent, from one repo.">
        {lead.map((word, i) => (
          <><span class="split-word" style={`--i:${i}`} aria-hidden="true">{word}</span>{' '}</>
        ))}
        <em class="hero__accent">
          {accent.map((word, i) => (
            <><span class="split-word" style={`--i:${lead.length + i}`} aria-hidden="true">{word}</span>{i < accent.length - 1 ? ' ' : ''}</>
          ))}
        </em>
      </h1>
      <p data-intro style="--d:560">
        Write a skill once in <code>.gandalf/skills/</code>. Gandalf installs it into Claude Code, Codex, and Cursor — reviewed in PRs, drift-checked in CI, rolled back in one command.
      </p>
      <ul class="hero__boundaries" aria-label="Gandalf product boundaries">
        {['One SKILL.md, three agents', 'Skill drift gate in CI', 'Snapshot + restore', 'Free, open-source CLI'].map((item, i) => (
          <li style={`--i:${i}`}>{item}</li>
        ))}
      </ul>
      <div class="hero__installbar" data-intro style="--d:960">
        <a href="#install" class="hero__install">
          <Download size={15} strokeWidth={2} aria-hidden="true" />
          Install
        </a>
        <code><span>$</span> {installCommand}</code>
        <button
          type="button"
          aria-label="Copy install command"
          class="hero__copycmd"
          data-copy={installCommand}
        >
          <Copy size={14} strokeWidth={2} aria-hidden="true" />
        </button>
      </div>
    </div>

    <div class="hero__product" data-intro style="--d:1100" aria-label="Gandalf genuine xterm terminal preview">
      <div class="hero__tilt">
        <div class="hero__glow" aria-hidden="true"></div>
        <XTermTerminal client:only="react" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 12px;
    background: #ffffff;
  }

  .hero__scene {
    position: relative;
    min-height: auto;
    padding-bottom: 36px;
    overflow: hidden;
    border: 1px solid #dbe3ea;
    border-radius: 24px;
    background:
      radial-gradient(circle at 50% 42%, rgb(255 255 255 / 0.96) 0 20%, transparent 48%),
      linear-gradient(180deg, rgb(248 252 255 / 0.96), rgb(255 255 255 / 0.96) 58%),
      linear-gradient(120deg, #dff5ff, #ffffff 42%, #eff6f9);
    box-shadow: 0 16px 40px -32px rgb(15 23 42 / 0.35);
  }

  .hero__scene::before {
    content: "";
    position: absolute;
    z-index: 1;
    inset: 48px 0 auto;
    height: 280px;
    pointer-events: none;
    background:
      linear-gradient(rgb(148 163 184 / 0.13) 1px, transparent 1px),
      linear-gradient(90deg, rgb(148 163 184 / 0.13) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: linear-gradient(to bottom, transparent, black 18%, transparent 95%);
  }

  .hero__copy {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 16px auto 14px;
    text-align: center;
  }

  .hero__copy h1 {
    max-width: 700px;
    margin: 0 auto 10px;
    font-size: clamp(2rem, 3.4vw, 3.1rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .hero__accent {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .hero__copy p {
    max-width: 560px;
    margin: 0 auto 14px;
    color: var(--muted-foreground);
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .hero__boundaries {
    display: flex;
    justify-content: center;
    gap: 6px 14px;
    margin: 0 auto 18px;
    padding: 0;
    color: var(--muted-foreground);
    font-size: 0.8rem;
    list-style: none;
    flex-wrap: wrap;
  }

  .hero__copy code {
    font-family: var(--font-mono);
    color: var(--foreground);
    font-size: 0.9em;
  }

  .hero__installbar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: min(100%, 580px);
    height: 38px;
    border: 1px solid rgb(9 9 11 / 0.08);
    border-radius: 6px;
    overflow: hidden;
    background: rgb(250 250 250 / 0.78);
    box-shadow: 0 10px 28px -20px rgb(15 23 42 / 0.4);
  }

  .hero__install {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    gap: 6px;
    padding: 0 14px;
    color: #ffffff;
    background: var(--foreground);
    font-size: 0.84rem;
    font-weight: 600;
  }

  .hero__install:hover {
    color: #ffffff;
    background: var(--foreground-soft);
  }

  .hero__install svg,
  .hero__copycmd svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hero__installbar code {
    min-width: 0;
    max-width: none;
    padding: 0 12px;
    overflow: visible;
    color: #71717a;
    font-size: 0.82rem;
    white-space: nowrap;
  }

  .hero__installbar code span {
    color: var(--brand);
    margin-right: 4px;
  }

  .hero__copycmd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    margin-right: 6px;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--muted-foreground);
  }

  .hero__copycmd:hover {
    color: var(--foreground);
    background: rgb(9 9 11 / 0.05);
  }

  .hero__product {
    position: relative;
    z-index: 1;
    width: min(980px, calc(100% - 48px));
    margin: 20px auto 0;
  }

  .hero__tilt {
    position: relative;
  }

  .hero__glow {
    position: absolute;
    inset: 18% 6% -6%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(56 189 248 / 0.18), rgb(148 163 184 / 0.14) 55%, transparent);
    filter: blur(40px);
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .hero {
      padding: 0;
    }

    .hero__scene {
      min-height: auto;
      border-radius: 0;
      border-left: 0;
      border-right: 0;
    }

    .hero__copy {
      width: min(calc(100% - 32px), 720px);
      margin: 24px auto 20px;
    }

    .hero__copy h1 {
      font-size: clamp(2.6rem, 10vw, 3.8rem);
      line-height: 0.98;
    }

    .hero__installbar {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      width: min(100%, 340px);
      height: 42px;
      margin: 0 auto;
    }

    .hero__installbar code {
      max-width: none;
      padding: 0 10px;
      font-size: 0.7rem;
    }

    .hero__copycmd {
      display: none;
    }

    .hero__product {
      width: min(calc(100% - 20px), 720px);
      margin: 0 auto -16px;
    }
  }
</style>
