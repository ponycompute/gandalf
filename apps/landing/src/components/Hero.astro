---
import { Copy, Download } from 'lucide-react';
import Nav from './Nav.astro';
import XTermTerminal from './ui/XTermTerminal';
---

<section class="hero">
  <div class="hero__scene">
    <Nav />

    <div class="hero__copy">
      <h1>Your team uses three agents. Gandalf gives them one config.</h1>
      <p>
        Claude Code, Codex, and Cursor each keep their own MCP servers, skills, and hooks. Gandalf puts them in one <code>gandalf.toml</code> — reviewed in PRs, enforced in CI, rolled back in one command.
      </p>
      <ul class="hero__boundaries" aria-label="Gandalf product boundaries">
        <li>Built for mixed-agent teams</li>
        <li>Drift gate in CI</li>
        <li>Snapshot + restore</li>
        <li>Free, open-source CLI</li>
      </ul>
      <div class="hero__installbar">
        <a href="#install" class="hero__install">
          <Download size={15} strokeWidth={2} aria-hidden="true" />
          Install
        </a>
        <code><span>$</span> brew install qyinm/tap/gandalf</code>
        <button
          type="button"
          aria-label="Copy install command"
          class="hero__copycmd"
          onclick="navigator.clipboard.writeText('brew install qyinm/tap/gandalf'); alert('Command copied to clipboard!');"
        >
          <Copy size={14} strokeWidth={2} aria-hidden="true" />
        </button>
      </div>
    </div>

    <div class="hero__product" aria-label="Gandalf genuine xterm terminal preview">
      <XTermTerminal client:only="react" />
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 12px;
    background: #ffffff;
  }

  .hero__scene {
    position: relative;
    min-height: auto;
    padding-bottom: 36px;
    overflow: hidden;
    border: 1px solid #dbe3ea;
    border-radius: 24px;
    background:
      radial-gradient(circle at 50% 42%, rgb(255 255 255 / 0.96) 0 20%, transparent 48%),
      linear-gradient(180deg, rgb(248 252 255 / 0.96), rgb(255 255 255 / 0.96) 58%),
      linear-gradient(120deg, #dff5ff, #ffffff 42%, #eff6f9);
    box-shadow: 0 16px 40px -32px rgb(15 23 42 / 0.35);
  }

  .hero__scene::before {
    content: "";
    position: absolute;
    inset: 48px 0 auto;
    height: 280px;
    pointer-events: none;
    background:
      linear-gradient(rgb(148 163 184 / 0.13) 1px, transparent 1px),
      linear-gradient(90deg, rgb(148 163 184 / 0.13) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: linear-gradient(to bottom, transparent, black 18%, transparent 95%);
  }

  .hero__copy {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 16px auto 14px;
    text-align: center;
  }

  .hero__copy h1 {
    max-width: 680px;
    margin: 0 auto 10px;
    font-size: clamp(2rem, 3.4vw, 3.1rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .hero__copy p {
    max-width: 560px;
    margin: 0 auto 14px;
    color: var(--muted-foreground);
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .hero__boundaries {
    display: flex;
    justify-content: center;
    gap: 6px 14px;
    margin: 0 auto 18px;
    padding: 0;
    color: var(--muted-foreground);
    font-size: 0.8rem;
    list-style: none;
    flex-wrap: wrap;
  }

  .hero__copy code {
    font-family: var(--font-mono);
    color: var(--foreground);
    font-size: 0.9em;
  }

  .hero__installbar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: min(100%, 580px);
    height: 38px;
    border: 1px solid rgb(9 9 11 / 0.08);
    border-radius: 6px;
    overflow: hidden;
    background: rgb(250 250 250 / 0.78);
    box-shadow: 0 10px 28px -20px rgb(15 23 42 / 0.4);
  }

  .hero__install {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    gap: 6px;
    padding: 0 14px;
    color: #ffffff;
    background: var(--foreground);
    font-size: 0.84rem;
    font-weight: 600;
  }

  .hero__install:hover {
    color: #ffffff;
    background: var(--foreground-soft);
  }

  .hero__install svg,
  .hero__copycmd svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hero__installbar code {
    min-width: 0;
    max-width: none;
    padding: 0 12px;
    overflow: visible;
    color: #71717a;
    font-size: 0.82rem;
    white-space: nowrap;
  }

  .hero__installbar code span {
    color: var(--brand);
    margin-right: 4px;
  }

  .hero__copycmd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    margin-right: 6px;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--muted-foreground);
  }

  .hero__copycmd:hover {
    color: var(--foreground);
    background: rgb(9 9 11 / 0.05);
  }

  .hero__product {
    position: relative;
    z-index: 1;
    width: min(980px, calc(100% - 48px));
    margin: 20px auto 0;
  }

  @media (max-width: 900px) {
    .hero {
      padding: 0;
    }

    .hero__scene {
      min-height: auto;
      border-radius: 0;
      border-left: 0;
      border-right: 0;
    }

    .hero__copy {
      width: min(calc(100% - 32px), 720px);
      margin: 24px auto 20px;
    }

    .hero__copy h1 {
      font-size: clamp(2.6rem, 10vw, 3.8rem);
      line-height: 0.98;
    }

    .hero__installbar {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      width: min(100%, 340px);
      height: 42px;
      margin: 0 auto;
    }

    .hero__installbar code {
      max-width: none;
      padding: 0 10px;
      font-size: 0.7rem;
    }

    .hero__copycmd {
      display: none;
    }

    .hero__product {
      width: min(calc(100% - 20px), 720px);
      margin: 0 auto -16px;
    }
  }
</style>
