---
import { GithubIcon } from 'lucide-react';
// Gandalf nav
---

<header class="nav">
  <div class="container nav__inner">
    <a href="/" class="nav__logo" aria-label="Gandalf home">
      <img src="/gandalf-mark-bold-v2.svg" alt="" class="nav__logo-mark" width="32" height="28" aria-hidden="true" />
      <span class="nav__logo-text">Gandalf</span>
      <span class="nav__badge">v0.9.0</span>
    </a>
    <nav class="nav__links" aria-label="Primary">
      <a href="https://docs.usegandalf.com">Docs</a>
      <a href="https://github.com/qyinm/gandalf" target="_blank" rel="noopener">
        <GithubIcon size={14} strokeWidth={2} aria-hidden="true" />
        GitHub
      </a>
      <a href="#skills">Skills</a>
      <a href="#why">Why</a>
      <a href="#primitives">Commands</a>
      <a href="#pricing">Pricing</a>
      <a href="#install" class="nav__cta">
        Install
      </a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: relative;
    z-index: 2;
    background: transparent;
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(calc(100% - 48px), var(--max-width));
    margin: 0 auto;
    height: 54px;
    min-width: 0;
  }

  .nav__logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--foreground);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0;
    min-width: 0;
  }

  .nav__logo-mark {
    display: block;
    width: 32px;
    height: 28px;
    flex: 0 0 auto;
    object-fit: contain;
  }

  .nav__logo-text {
    color: var(--foreground);
  }

  .nav__badge {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    color: var(--brand);
    background: var(--brand-soft);
    border: 1px solid rgb(255 95 106 / 0.2);
    padding: 1px 7px;
    border-radius: 9999px;
    margin-left: 2px;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    color: var(--muted-foreground);
    flex: 0 0 auto;
  }

  .nav__links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 32px;
    gap: 5px;
    padding: 0 10px;
    border-radius: var(--radius-sm);
    transition: color 0.15s;
  }

  .nav__links a:hover {
    background: rgb(9 9 11 / 0.04);
    color: var(--foreground);
  }

  .nav__links svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .nav__links .nav__cta {
    height: 30px;
    width: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0 14px;
    margin-left: 6px;
    border-radius: var(--radius-sm);
    background: var(--foreground) !important;
    color: #ffffff !important;
    font-weight: 600;
    font-size: 0.84rem;
    box-shadow: 0 6px 16px -8px rgb(0 0 0 / 0.6);
  }

  .nav__links .nav__cta:hover {
    color: #ffffff;
    background: var(--foreground-soft) !important;
  }

  @media (max-width: 1120px) {
    .nav__inner {
      width: min(calc(100% - 32px), var(--max-width));
    }

    .nav__links {
      gap: 6px;
      font-size: 0.85rem;
    }
  }

  @media (max-width: 480px) {
    .nav__inner {
      height: 48px;
    }

    .nav__logo {
      font-size: 0.98rem;
    }

    .nav__logo-mark {
      width: 28px;
      height: 24px;
    }

    .nav__links {
      gap: 8px;
      font-size: 0.85rem;
    }

    .nav__links a:nth-child(2),
    .nav__links a:nth-child(3),
    .nav__links a:nth-child(4),
    .nav__links a:nth-child(5),
    .nav__links a:nth-child(6),
    .nav__links .nav__cta {
      display: none;
    }
  }
</style>
