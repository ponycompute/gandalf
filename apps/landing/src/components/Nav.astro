---
const links = [
  { label: 'How it works', href: '#how' },
  { label: 'Docs', href: 'https://docs.usegandalf.com' },
  { label: 'Changelog', href: 'https://github.com/qyinm/gandalf/releases' },
  { label: 'GitHub', href: 'https://github.com/qyinm/gandalf' },
];
---

<header class="nav">
  <div class="container nav__inner">
    <a href="/" class="nav__logo" aria-label="Gandalf home">
      <img src="/gandalf-mark-bold-v2.svg" alt="" width="26" height="22" aria-hidden="true" />
      <span>Gandalf</span>
    </a>
    <nav class="nav__links" aria-label="Primary">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <a href="#install" class="btn btn--primary nav__cta">Install</a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid transparent;
    background: rgb(250 250 249 / 0.85);
    backdrop-filter: saturate(1.4) blur(10px);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 60px;
  }

  .nav__logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .nav__links {
    display: flex;
    gap: 24px;
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }

  .nav__links a:hover {
    color: var(--foreground);
  }

  .nav__cta {
    height: 32px;
    margin-left: auto;
  }

  @media (max-width: 760px) {
    .nav__links {
      display: none;
    }
  }
</style>
