---
import { Code2, Download } from 'lucide-react';

const commands = ['gandalf init', 'gandalf check --ci', 'gandalf apply --dry-run', 'gandalf apply --yes', 'gandalf restore', 'gandalf export'];
---
<section class="section closing">
  <div class="container">
    <div class="closing__inner">
      <div>
        <p class="section-meta">
          <span class="section-meta__num">06</span> &nbsp;/&nbsp; Ready
        </p>
        <h2 class="closing__title">
          <span class="closing__line" data-clip-up>Ship skills</span>
          <span class="closing__line" data-clip-up style="--i:1"><em>like code.</em></span>
        </h2>
      </div>
      <div class="closing__aside" data-reveal style="--i:1">
        <p class="closing__lede">
          Review in PRs. Gate in CI. Roll back in one command.
        </p>
        <div class="closing__actions">
          <a href="#install" class="btn btn--primary" data-magnetic="0.25">
            <Download size={16} strokeWidth={2} aria-hidden="true" />
            Install
          </a>
          <a href="https://github.com/qyinm/gandalf" class="btn btn--outline" target="_blank" rel="noopener" data-magnetic="0.25">
            <Code2 size={16} strokeWidth={2} aria-hidden="true" />
            GitHub
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {[0, 1].map(() => (
        <div class="marquee__group">
          {commands.map((cmd) => (
            <span><b>$</b> {cmd}</span>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .closing {
    padding-bottom: 74px;
    background: rgb(255 255 255 / 0.82);
  }

  .closing__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 34px;
    align-items: end;
    padding: 44px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: transparent;
  }

  .closing__title {
    font-family: var(--font-sans);
    font-size: clamp(2.2rem, 5.2vw, 5.2rem);
    font-weight: 680;
    letter-spacing: 0;
    line-height: 0.98;
    max-width: 11ch;
  }

  .closing__line {
    display: block;
  }

  .closing__title em {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 600;
  }

  .marquee {
    margin-top: 40px;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  .marquee__track {
    display: flex;
    width: max-content;
  }

  .marquee__group {
    display: flex;
    gap: 14px;
    padding-right: 14px;
  }

  .marquee__group span {
    padding: 8px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted-foreground);
    white-space: nowrap;
  }

  .marquee__group b {
    font-weight: 500;
    color: var(--foreground);
  }

  .closing__lede {
    font-size: 0.98rem;
    color: var(--muted-foreground);
    line-height: 1.65;
    margin-bottom: 24px;
  }

  .closing__actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .closing__actions svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 780px) {
    .closing__inner {
      grid-template-columns: 1fr;
      padding: 28px;
    }
  }
</style>
