---
import Terminal from './ui/Terminal';
import TerminalSlot from './TerminalSlot.astro';
---

<section class="section install" id="install">
  <div class="container install__grid">
    <div>
      <p class="eyebrow">Install</p>
      <h2 class="h2">Install the CLI.</h2>
      <p class="lede">
        macOS on Apple silicon and Intel. Run <code>gandalf</code> to see your skills right away, and <code>gandalf init</code> when you want handoff.
      </p>
    </div>
    <TerminalSlot rows={4} tabs>
    <Terminal
      client:only="react"
      copyable
      playWhenVisible
      rows={4}
      cwd="~"
      sessions={[
        { id: 'brew', label: 'Homebrew', typeOnly: 'brew install qyinm/tap/gandalf' },
        { id: 'curl', label: 'curl', typeOnly: 'curl -fsSL https://raw.githubusercontent.com/ponycompute/gandalf/main/install.sh | sh' },
        { id: 'source', label: 'From source', typeOnly: 'git clone https://github.com/ponycompute/gandalf.git && cd gandalf && make build' },
      ]}
    />
    </TerminalSlot>
  </div>
</section>

<style>
  .install__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 64px;
    align-items: center;
  }

  .install code {
    font-size: 0.875em;
    color: var(--foreground);
  }

  @media (max-width: 860px) {
    .install__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
