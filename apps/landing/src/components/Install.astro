---
import InstallTabs from './InstallTabs';
---

<section class="section install" id="install">
  <div class="container install__grid">
    <div>
      <p class="eyebrow">Install</p>
      <h2 class="h2">Install the CLI.</h2>
      <p class="lede">
        Then run <code>gandalf export</code> in a repo to collect the skills your agents already have.
      </p>
    </div>
    <InstallTabs client:visible />
  </div>
</section>

<style is:global>
  .install-tabs {
    border: 1px solid #23231f;
    border-radius: var(--radius);
    background: var(--term-bg);
    overflow: hidden;
  }

  .install-tabs__bar {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px 8px;
    border-bottom: 1px solid #23231f;
  }

  .install-tabs__tab {
    height: 28px;
    padding: 0 10px;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--term-dim);
  }

  .install-tabs__tab:hover {
    color: var(--term-fg);
  }

  .install-tabs__tab[data-state="active"] {
    background: #23231f;
    color: #fff;
  }

  .install-tabs__copy {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    margin-left: auto;
    padding: 0 10px;
    border: 1px solid #2e2e29;
    border-radius: var(--radius-sm);
    background: transparent;
    font-size: 0.75rem;
    color: var(--term-dim);
  }

  .install-tabs__copy:hover {
    border-color: #4a4a43;
    color: var(--term-fg);
  }

  .install-tabs__pre {
    margin: 0;
    padding: 20px 16px 8px;
  }

  .install-tabs__pre code {
    display: block;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--term-fg);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .install-tabs__sigil {
    margin-right: 4px;
    color: var(--brand);
    user-select: none;
  }

  .install-tabs__hint {
    padding: 0 16px 18px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--term-dim);
  }
</style>

<style>
  .install__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 64px;
    align-items: center;
  }

  .install code {
    font-size: 0.875em;
    color: var(--foreground);
  }

  @media (max-width: 860px) {
    .install__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
