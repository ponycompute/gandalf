---
import { Check } from 'lucide-react';

type Feature = { label: string; soon?: boolean };

type Plan = {
  name: string;
  price: string;
  cadence: string;
  blurb: string;
  badge?: string;
  features: Feature[];
  cta: { label: string; href: string };
  featured?: boolean;
};

const plans: Plan[] = [
  {
    name: "Free",
    price: "$0",
    cadence: "forever",
    blurb: "The full CLI. Open source, local-first, no account.",
    features: [
      { label: "Team skills for Claude Code, Codex, and Cursor" },
      { label: "gandalf check --ci and the GitHub Action" },
      { label: "Snapshots before every apply, gandalf restore to undo" },
      { label: "Unlimited skills, repos, and developers" },
    ],
    cta: { label: "Install", href: "#install" },
  },
  {
    name: "Team",
    price: "$49",
    cadence: "per month · 10 seats",
    blurb: "For teams that want skills owned by the team, not by dotfiles.",
    badge: "Early access",
    features: [
      { label: "Everything in Free" },
      { label: "Up to 10 seats" },
      { label: "Team-wide skill drift visibility across repos" },
      { label: "Export to vendor managed settings", soon: true },
    ],
    cta: { label: "Get early access", href: "#team-plan" },
    featured: true,
  },
  {
    name: "Business",
    price: "Contact us",
    cadence: "custom seats",
    blurb: "For orgs that need to govern which agent tools are allowed.",
    features: [
      { label: "Everything in Team" },
      { label: "MCP server allowlist" },
      { label: "Audit log" },
      { label: "SSO" },
    ],
    cta: { label: "Talk to us", href: "mailto:hello@usegandalf.com?subject=Gandalf%20Business%20plan" },
  },
];
---

<section class="section pricing" id="pricing">
  <div class="container">
    <p class="eyebrow">Pricing</p>
    <h2 class="h2">The CLI is free. The team plan is in early access.</h2>
    <p class="lede">Everything on this page except the team plan is open source and runs locally. Paid features are added on top and never taken out of the CLI.</p>

    <div class="plans" aria-label="Gandalf plans">
      {plans.map((plan) => (
        <article class:list={['plan', { 'plan--featured': plan.featured }]}>
          <div class="plan__top">
            <h3>{plan.name}</h3>
            {plan.badge && <span class="preview-tag">{plan.badge}</span>}
          </div>
          <p class="plan__price">
            <strong>{plan.price}</strong>
            <span>{plan.cadence}</span>
          </p>
          <p class="plan__blurb">{plan.blurb}</p>
          <ul class="plan__features">
            {plan.features.map((feature) => (
              <li>
                <Check size={14} strokeWidth={2} aria-hidden="true" />
                <span>
                  {feature.label}
                  {feature.soon && <em class="plan__soon"> (later)</em>}
                </span>
              </li>
            ))}
          </ul>
          <a href={plan.cta.href} class:list={['btn', plan.featured ? 'btn--primary' : 'btn--outline', 'plan__cta']}>
            {plan.cta.label}
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .plans {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 48px;
    border-top: 1px solid var(--border);
  }

  .plan {
    display: flex;
    flex-direction: column;
    padding: 32px 32px 0 0;
  }

  .plan + .plan {
    padding-left: 32px;
    border-left: 1px solid var(--border);
  }

  .plan__top {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .plan__top h3 {
    font-size: 1rem;
  }

  .plan__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    margin-top: 16px;
  }

  .plan__price strong {
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .plan__price span,
  .plan__blurb {
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }

  .plan__blurb {
    min-height: 3em;
    margin-top: 8px;
  }

  .plan__features {
    display: grid;
    gap: 10px;
    margin: 24px 0 32px;
    padding: 0;
    list-style: none;
    flex-grow: 1;
    font-size: 0.875rem;
  }

  .plan__features li {
    display: flex;
    gap: 10px;
  }

  .plan__features svg {
    flex: 0 0 auto;
    margin-top: 4px;
    color: var(--muted-foreground);
  }

  .plan__soon {
    font-style: normal;
    color: var(--muted-foreground);
  }

  .plan__cta {
    align-self: flex-start;
  }

  @media (max-width: 860px) {
    .plans {
      grid-template-columns: 1fr;
    }

    .plan,
    .plan + .plan {
      padding: 32px 0;
      border-left: 0;
    }

    .plan + .plan {
      border-top: 1px solid var(--border);
    }
  }
</style>
