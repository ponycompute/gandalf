---
const agents = [
  { name: 'Claude Code', user: '~/.claude/skills/', project: '.claude/skills/', handoff: 'Yes' },
  { name: 'Codex', user: '~/.codex/skills/', project: '.codex/skills/', handoff: 'Yes' },
  { name: 'Cursor', user: '~/.cursor/skills/', project: '.cursor/skills/', handoff: 'Not yet' },
];

const facts = [
  { label: 'No silent overwrites', text: 'Copies that differ are only replaced when you pass <code>--from</code> or <code>--force</code>.' },
  { label: 'Recoverable', text: 'Replaced and removed skills move to <code>~/.gandalf/trash</code>. Nothing is deleted.' },
  { label: 'Handoff is opt-in', text: 'Nothing is recorded until you run <code>gandalf init</code>. Evidence is encrypted with a key kept in the macOS keychain.' },
  { label: 'Local only', text: 'One binary, no account, no cloud. Gandalf never runs agent commands or assigns work.' },
];
---

<section class="section details">
  <div class="container">
    <p class="eyebrow">Details</p>
    <h2 class="h2">What Gandalf reads, and what it promises.</h2>

    <div class="details__grid">
      <div class="table-wrap">
        <table class="agents">
          <thead>
            <tr>
              <th scope="col">Agent</th>
              <th scope="col">User skills</th>
              <th scope="col">Project skills</th>
              <th scope="col">Handoff</th>
            </tr>
          </thead>
          <tbody>
            {agents.map((agent) => (
              <tr>
                <th scope="row">{agent.name}</th>
                <td><code>{agent.user}</code></td>
                <td><code>{agent.project}</code></td>
                <td class:list={{ dim: agent.handoff === 'Not yet' }}>{agent.handoff}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="agents__note">Gandalf manages skills only. It does not touch MCP servers, hooks, or agent settings beyond registering its own handoff integration.</p>
      </div>

      <dl class="facts">
        {facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd set:html={fact.text} />
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .details__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 64px;
    margin-top: 48px;
  }

  .table-wrap {
    overflow-x: auto;
  }

  .agents {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .agents th,
  .agents td {
    padding: 14px 16px 14px 0;
    border-bottom: 1px solid var(--border);
    text-align: left;
    white-space: nowrap;
  }

  .agents thead th {
    padding-top: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--muted-foreground);
  }

  .agents tbody th {
    font-weight: 500;
  }

  .agents td {
    color: var(--muted-foreground);
  }

  .agents code {
    font-size: 0.8125rem;
    color: var(--foreground);
  }

  .agents .dim {
    color: var(--faint-foreground);
  }

  .agents__note {
    margin-top: 16px;
    font-size: 0.8125rem;
    color: var(--muted-foreground);
  }

  .facts {
    display: grid;
    gap: 24px;
    margin: 0;
  }

  .facts dt {
    font-weight: 500;
  }

  .facts dd :global(code) {
    font-size: 0.875em;
    color: var(--foreground);
    white-space: nowrap;
  }

  .facts dd {
    margin: 4px 0 0;
    font-size: 0.9375rem;
    color: var(--muted-foreground);
  }

  @media (max-width: 860px) {
    .details__grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>
