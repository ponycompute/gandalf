---
const columns = [
  {
    title: 'Product',
    links: [
      { label: 'How it works', href: '#how' },
      { label: 'Install', href: '#install' },
      { label: 'Team plan', href: '#team-plan' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Docs', href: 'https://docs.usegandalf.com' },
      { label: 'Changelog', href: 'https://github.com/qyinm/gandalf/releases' },
      { label: 'GitHub', href: 'https://github.com/qyinm/gandalf' },
      { label: 'Contact', href: 'mailto:hello@usegandalf.com' },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__cta">
      <h2 class="footer__title">Write the skill once.</h2>
      <a href="#install" class="btn btn--primary">Install Gandalf</a>
    </div>

    <div class="footer__bottom">
      <a href="/" class="footer__brand" aria-label="Gandalf home">
        <img src="/gandalf-mark-bold-v2.svg" alt="" width="26" height="22" aria-hidden="true" />
        <span>Gandalf</span>
      </a>
      {columns.map((column) => (
        <nav class="footer__col" aria-label={column.title}>
          <p>{column.title}</p>
          {column.links.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
      ))}
      <p class="footer__meta">© {year} Gandalf · Apache-2.0</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 112px 0 48px;
    border-top: 1px solid var(--border);
  }

  .footer__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .footer__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .footer__bottom {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: 32px;
    margin-top: 96px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
    font-size: 0.875rem;
  }

  .footer__brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    align-self: start;
    font-weight: 600;
  }

  .footer__col {
    display: grid;
    gap: 10px;
    align-content: start;
    color: var(--muted-foreground);
  }

  .footer__col p {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--faint-foreground);
  }

  .footer__col a:hover {
    color: var(--foreground);
  }

  .footer__meta {
    justify-self: end;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--faint-foreground);
  }

  @media (max-width: 720px) {
    .footer {
      padding: 72px 0 40px;
    }

    .footer__bottom {
      grid-template-columns: 1fr 1fr;
      margin-top: 64px;
    }

    .footer__brand,
    .footer__meta {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }
</style>
