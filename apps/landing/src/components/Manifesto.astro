---
import { GitFork, ShieldAlert, UserPlus } from 'lucide-react';
import ManifestoSplitBoard from './ui/ManifestoSplitBoard';

const problems = [
  {
    label: "Onboarding",
    title: "New hires rebuild skills by hand.",
    desc: "Someone zips their ~/.claude/skills, the new engineer pastes it in, then recreates the Codex and Cursor copies from memory.",
  },
  {
    label: "Drift",
    title: "Three copies of one skill drift apart.",
    desc: "A fix lands in one engineer's Claude Code skill. The Codex and Cursor copies — and everyone else's — quietly go stale.",
  },
  {
    label: "Governance",
    title: "Nobody reviews what a skill tells the agent to do.",
    desc: "Skills are instructions your agents follow. In personal dotfiles there is no diff, no owner, and no way to roll back.",
  },
];
---

<section class="section manifesto" id="why">
  <div class="container manifesto__grid">
    <div class="manifesto__copy" data-reveal>
      <p class="section-meta">
        <span class="section-meta__num">01</span> &nbsp;/&nbsp; The Problem
      </p>

      <h2 class="section-title manifesto__title">
        Your best skills are stuck in one engineer's dotfiles.
      </h2>

      <p class="section-lede manifesto__lede">
        Your team runs Claude Code, Codex, and Cursor side by side. Each keeps its own skills folder — so the reviewer skill, the migration skill, and the release checklist get copied by hand and never reviewed.
      </p>
    </div>

    <div class="manifesto__terminal" data-reveal style="--i:1" aria-label="Agent Environment as Code proof">
      <ManifestoSplitBoard client:only="react" />
    </div>
  </div>

  <div class="container">
    <div class="problems" aria-label="What breaks without shared team skills">
      {problems.map((problem, index) => (
        <article class="problems__cell" data-reveal data-spotlight style={`--i:${index}`}>
          <span class="problems__label">{problem.label}</span>
          {index === 0 && <UserPlus className="problems__icon" size={22} strokeWidth={2} aria-hidden="true" />}
          {index === 1 && <GitFork className="problems__icon" size={22} strokeWidth={2} aria-hidden="true" />}
          {index === 2 && <ShieldAlert className="problems__icon" size={22} strokeWidth={2} aria-hidden="true" />}
          <h3>{problem.title}</h3>
          <p>{problem.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .manifesto {
    background: rgb(255 255 255 / 0.84);
  }

  .manifesto__grid {
    display: grid;
    grid-template-columns: minmax(280px, 0.72fr) minmax(0, 1.28fr);
    gap: 54px;
    align-items: center;
  }

  .manifesto__title {
    max-width: 16ch;
    font-size: clamp(2.0rem, 2.8vw, 2.8rem);
    line-height: 1.15;
  }

  .manifesto__lede {
    max-width: 38ch;
    font-size: 0.96rem;
    line-height: 1.6;
    margin-top: 14px;
    color: var(--muted-foreground);
  }

  .problems {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 48px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: rgb(255 255 255 / 0.92);
    box-shadow: 0 10px 30px -20px rgb(15 23 42 / 0.25);
  }

  .problems__cell {
    display: flex;
    flex-direction: column;
    padding: 28px 24px;
    border-right: 1px solid var(--border);
  }

  .problems__cell:last-child {
    border-right: none;
  }

  .problems__label {
    margin-bottom: 12px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  :global(.problems__icon) {
    color: var(--foreground);
    margin-bottom: 14px;
  }

  .problems__cell h3 {
    margin-bottom: 10px;
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .problems__cell p {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--muted-foreground);
  }

  .manifesto__terminal {
    min-width: 0;
    width: 100%;
  }

  @media (max-width: 900px) {
    .manifesto__grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .problems {
      grid-template-columns: 1fr;
      margin-top: 36px;
    }

    .problems__cell {
      border-right: none;
      border-bottom: 1px solid var(--border);
    }

    .problems__cell:last-child {
      border-bottom: none;
    }
  }
</style>
