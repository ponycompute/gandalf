---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Handoff from '../components/Handoff.astro';
import Details from '../components/Details.astro';
import Install from '../components/Install.astro';
import Pricing from '../components/Pricing.astro';
import Waitlist from '../components/Waitlist.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Gandalf · Shared skills for every coding agent"
  description="Gandalf keeps one set of skills in your repo and installs it into Claude Code, Codex, and Cursor. With agbox, it notices the work you repeat and drafts the skill for you."
>
  <Nav />
  <main>
    <Hero />
    <HowItWorks />
    <Handoff />
    <Details />
    <Install />
    <Pricing />
    <Waitlist />
  </main>
  <Footer />
</BaseLayout>
