---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Manifesto from '../components/Manifesto.astro';
import Primitives from '../components/Primitives.astro';
import Install from '../components/Install.astro';
import Pricing from '../components/Pricing.astro';
import Waitlist from '../components/Waitlist.astro';
import Closing from '../components/Closing.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Gandalf — One config for every coding agent your team uses"
  description="Claude Code, Codex, and Cursor each manage their own MCP servers, skills, and hooks. Gandalf puts them in one gandalf.toml — reviewed in PRs, enforced in CI, rolled back in one command."
>
  <main>
    <Hero />
    <Manifesto />
    <Primitives />
    <Install />
    <Pricing />
    <Waitlist />
    <Closing />
  </main>
  <Footer />
</BaseLayout>
