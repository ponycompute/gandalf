---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Convergence from '../components/Convergence.astro';
import Manifesto from '../components/Manifesto.astro';
import Primitives from '../components/Primitives.astro';
import Install from '../components/Install.astro';
import Pricing from '../components/Pricing.astro';
import Waitlist from '../components/Waitlist.astro';
import Closing from '../components/Closing.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Gandalf — Team skills for every coding agent"
  description="Write a skill once. Gandalf installs it into Claude Code, Codex, and Cursor from one repo — reviewed in PRs, drift-checked in CI, rolled back in one command."
>
  <main>
    <Hero />
    <Convergence />
    <Manifesto />
    <Primitives />
    <Install />
    <Pricing />
    <Waitlist />
    <Closing />
  </main>
  <Footer />
</BaseLayout>
