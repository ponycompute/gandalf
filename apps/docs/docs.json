{
  "$schema": "https://mintlify.com/schema.json",
  "name": "Gandalf",
  "logo": {
    "dark": "/apps/docs/images/gandalf-logo-dark.svg",
    "light": "https://raw.githubusercontent.com/ponycompute/gandalf/main/apps/landing/public/gandalf-mark.svg"
  },
  "favicon": "https://raw.githubusercontent.com/ponycompute/gandalf/main/apps/landing/public/favicon.svg",
  "colors": {
    "primary": "#ff5f6a",
    "light": "#ff8a92",
    "dark": "#e04652"
  },
  "topbarLinks": [
    {
      "name": "Main Site",
      "url": "https://usegandalf.com"
    },
    {
      "name": "GitHub",
      "url": "https://github.com/ponycompute/gandalf"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "index",
              "quickstart",
              "install",
              "trust-contract"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/support-matrix"
            ]
          }
        ]
      },
      {
        "tab": "CLI Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "cli/overview"
            ]
          },
          {
            "group": "Commands",
            "pages": [
              "cli/skill",
              "cli/distill",
              "cli/handoff"
            ]
          }
        ]
      }
    ]
  },
  "footerSocials": {
    "github": "https://github.com/ponycompute/gandalf"
  },
  "theme": "maple",
  "navbar": {
    "links": [
      {
        "href": "https://github.com/ponycompute/gandalf",
        "label": "GitHub"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Install",
      "href": "/install"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/ponycompute/gandalf"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ],
    "display": "header"
  },
  "styling": {
    "eyebrows": "section"
  },
  "fonts": {
    "family": "Inter"
  }
}
