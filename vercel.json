{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "turbo run build --filter=@gandalf/landing",
  "outputDirectory": "apps/landing/dist",
  "redirects": [
    {
      "source": "/install.sh",
      "destination": "https://raw.githubusercontent.com/ponycompute/gandalf/main/install.sh",
      "permanent": false
    },
    {
      "source": "/docs",
      "destination": "https://docs.usegandalf.com",
      "permanent": true
    },
    {
      "source": "/docs/:path*",
      "destination": "https://docs.usegandalf.com",
      "permanent": true
    }
  ]
}
